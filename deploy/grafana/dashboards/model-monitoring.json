{
  "title": "MENA Model Monitoring",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "title": "Prediction requests by deployment",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum by (deployment) (rate(bentoml_service_request_duration_seconds_count{endpoint=\"/predict\"}[5m]))",
          "legendFormat": "{{deployment}}"
        }
      ]
    },
    {
      "title": "Request latency p95",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, deployment) (rate(bentoml_service_request_duration_seconds_bucket{endpoint=\"/predict\"}[5m])))",
          "legendFormat": "{{deployment}}"
        }
      ]
    }
  ]
}
