{
  "title": "MENA Model Monitoring",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "title": "Total predictions",
      "type": "stat",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(increase(mena_model_predictions_total[$__range]))",
          "legendFormat": "predictions"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}},
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value"}
    },
    {
      "title": "Latency p50",
      "type": "stat",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "1000 * sum(rate(bentoml_service_request_duration_seconds_sum{endpoint=\"/predict\",http_response_code=\"200\"}[5m])) / sum(rate(bentoml_service_request_duration_seconds_count{endpoint=\"/predict\",http_response_code=\"200\"}[5m]))",
          "legendFormat": "one row"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ms", "decimals": 1}},
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value"}
    },
    {
      "title": "Latency p95",
      "type": "stat",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 8},
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(bentoml_service_request_duration_seconds_bucket{endpoint=\"/predict\",http_response_code=\"200\"}[5m])))",
          "legendFormat": "one row p95"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ms", "decimals": 1}},
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value"}
    },
    {
      "title": "Error rate",
      "type": "stat",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "100 * sum(rate(bentoml_service_request_total{endpoint=~\"/predict|/predict_batch\",http_response_code=~\"5..\"}[5m])) / clamp_min(sum(rate(bentoml_service_request_total{endpoint=~\"/predict|/predict_batch\"}[5m])), 1)",
          "legendFormat": "errors"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 5}]}}},
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value"}
    },
    {
      "title": "Maximum feature PSI",
      "type": "stat",
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 8},
      "targets": [{"expr": "mena_drift_psi_max", "legendFormat": "PSI"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 3, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.25}]}}},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value"}
    },
    {
      "title": "Prediction share",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "targets": [
        {
          "expr": "sum by (label) (increase(mena_model_predictions_total[$__range]))",
          "legendFormat": "{{label}}",
          "format": "time_series"
        }
      ],
      "fieldConfig": {"defaults": {}, "overrides": [
        {"matcher": {"id": "byName", "options": "positive"}, "properties": [{"id": "color", "value": {"fixed": "#56C596"}}]},
        {"matcher": {"id": "byName", "options": "negative"}, "properties": [{"id": "color", "value": {"fixed": "#E86A6A"}}]},
        {"matcher": {"id": "byName", "options": "neutral"}, "properties": [{"id": "color", "value": {"fixed": "#9AA6B2"}}]}
      ]},
      "options": {"legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]}, "pieType": "donut", "reduceOptions": {"calcs": ["sum"], "fields": "", "values": false}}
    },
    {
      "title": "Average confidence by class",
      "type": "barchart",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "targets": [
        {
          "expr": "100 * sum by (label) (increase(mena_model_prediction_confidence_sum[$__range])) / sum by (label) (increase(mena_model_prediction_confidence_count[$__range]))",
          "legendFormat": "{{label}}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "decimals": 1, "custom": {"drawStyle": "bars", "barAlignment": 0, "lineWidth": 0, "fillOpacity": 100, "showPoints": "never"}}, "overrides": [
        {"matcher": {"id": "byName", "options": "positive"}, "properties": [{"id": "color", "value": {"fixed": "#56C596"}}]},
        {"matcher": {"id": "byName", "options": "negative"}, "properties": [{"id": "color", "value": {"fixed": "#E86A6A"}}]},
        {"matcher": {"id": "byName", "options": "neutral"}, "properties": [{"id": "color", "value": {"fixed": "#9AA6B2"}}]}
      ]},
      "transformations": [
        {"id": "seriesToRows", "options": {}},
        {"id": "organize", "options": {"excludeByName": {"Time": true}}}
      ],
      "options": {
        "orientation": "vertical",
        "showValue": "always",
        "legend": {"displayMode": "hidden"}
      }
    },
    {
      "title": "Scored rows per second",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "targets": [
        {
          "expr": "sum(rate(bentoml_service_request_total{endpoint=\"/predict\",http_response_code=\"200\"}[5m]))",
          "legendFormat": "live rows/s"
        },
        {
          "expr": "sum(rate(mena_model_batch_rows_total[5m]))",
          "legendFormat": "batch rows/s"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 3}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "title": "Batch latency: whole chunk vs effective row",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "targets": [
        {
          "expr": "1000 * sum by (endpoint) (rate(bentoml_service_request_duration_seconds_sum{endpoint=\"/predict_batch\",http_response_code=\"200\"}[5m])) / sum by (endpoint) (rate(bentoml_service_request_duration_seconds_count{endpoint=\"/predict_batch\",http_response_code=\"200\"}[5m]))",
          "legendFormat": "whole chunk average"
        },
        {
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(bentoml_service_request_duration_seconds_bucket{endpoint=\"/predict_batch\",http_response_code=\"200\"}[5m])))",
          "legendFormat": "whole chunk p95"
        },
        {
          "expr": "1000 * sum(rate(mena_model_batch_row_latency_seconds_sum[5m])) / sum(rate(mena_model_batch_row_latency_seconds_count[5m]))",
          "legendFormat": "effective row average"
        },
        {
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(mena_model_batch_row_latency_seconds_bucket[5m])))",
          "legendFormat": "effective row p95"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ms", "decimals": 1}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    }
  ]
}
