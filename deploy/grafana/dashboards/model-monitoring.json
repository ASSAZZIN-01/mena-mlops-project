{
  "title": "MENA Model Monitoring",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "title": "Total predictions",
      "type": "stat",
      "description": "Total predictions recorded in the selected dashboard time range.",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(increase(mena_model_predictions_total[$__range]))",
          "legendFormat": "predictions"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "#5794F2"}}},
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value"}
    },
    {
      "title": "Latency p50",
      "type": "stat",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "1000 * sum(rate(bentoml_service_request_duration_seconds_sum{endpoint=\"/predict\",http_response_code=\"200\"}[5m])) / sum(rate(bentoml_service_request_duration_seconds_count{endpoint=\"/predict\",http_response_code=\"200\"}[5m]))",
          "legendFormat": "one row"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ms", "decimals": 1}},
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value"}
    },
    {
      "title": "Latency p95",
      "type": "stat",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 8},
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(bentoml_service_request_duration_seconds_bucket{endpoint=\"/predict\",http_response_code=\"200\"}[5m])))",
          "legendFormat": "one row p95"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ms", "decimals": 1}},
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value"}
    },
    {
      "title": "Error rate",
      "type": "stat",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "100 * sum(rate(bentoml_service_request_total{endpoint=~\"/predict|/predict_batch\",http_response_code=~\"5..\"}[5m])) / clamp_min(sum(rate(bentoml_service_request_total{endpoint=~\"/predict|/predict_batch\"}[5m])), 1)",
          "legendFormat": "errors"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 5}]}}},
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value"}
    },
    {
      "title": "Maximum feature PSI",
      "type": "stat",
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 8},
      "targets": [{"expr": "mena_drift_psi_max", "legendFormat": "PSI"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 3, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.25}]}}},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value"}
    },
    {
      "title": "Prediction share",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 8, "x": 6, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (label) (increase(mena_model_predictions_total{label=~\"positive|negative|neutral\"}[$__range])) or label_replace(vector(0), \"label\", \"positive\", \"\", \"\") or label_replace(vector(0), \"label\", \"negative\", \"\", \"\") or label_replace(vector(0), \"label\", \"neutral\", \"\", \"\")",
          "instant": true,
          "legendFormat": "{{label}}",
          "format": "time_series"
        }
      ],
      "fieldConfig": {"defaults": {}, "overrides": [
        {"matcher": {"id": "byRegexpOrNames", "options": ["positive"]}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#56C596"}}]},
        {"matcher": {"id": "byRegexpOrNames", "options": ["negative"]}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#E86A6A"}}]},
        {"matcher": {"id": "byRegexpOrNames", "options": ["neutral"]}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#9AA6B2"}}]}
      ]},
      "options": {"legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]}, "pieType": "donut", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "title": "Confidence Stats Per Class",
      "description": "Statistics are calculated on the confidence of predictions whose argmax class is the corresponding row, not across all predictions.",
      "type": "table",
      "gridPos": {"h": 8, "w": 10, "x": 14, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (label) (increase(mena_model_prediction_confidence_sum{label=~\"positive|negative|neutral\"}[$__range])) / clamp_min(sum by (label) (increase(mena_model_prediction_confidence_count{label=~\"positive|negative|neutral\"}[$__range])), 1) or label_replace(vector(0), \"label\", \"positive\", \"\", \"\") or label_replace(vector(0), \"label\", \"negative\", \"\", \"\") or label_replace(vector(0), \"label\", \"neutral\", \"\", \"\")",
          "instant": true,
          "legendFormat": "Average Confidence",
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "100 * min by (label) (min_over_time(mena_model_prediction_confidence_min{label=~\"positive|negative|neutral\"}[$__range])) and on (label) (sum by (label) (increase(mena_model_prediction_confidence_count{label=~\"positive|negative|neutral\"}[$__range])) > 0) or label_replace(vector(0), \"label\", \"positive\", \"\", \"\") or label_replace(vector(0), \"label\", \"negative\", \"\", \"\") or label_replace(vector(0), \"label\", \"neutral\", \"\", \"\")",
          "instant": true,
          "legendFormat": "Min Confidence",
          "format": "time_series"
        },
        {
          "refId": "C",
          "expr": "100 * max by (label) (max_over_time(mena_model_prediction_confidence_max{label=~\"positive|negative|neutral\"}[$__range])) and on (label) (sum by (label) (increase(mena_model_prediction_confidence_count{label=~\"positive|negative|neutral\"}[$__range])) > 0) or label_replace(vector(0), \"label\", \"positive\", \"\", \"\") or label_replace(vector(0), \"label\", \"negative\", \"\", \"\") or label_replace(vector(0), \"label\", \"neutral\", \"\", \"\")",
          "instant": true,
          "legendFormat": "Max Confidence",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100, "decimals": 1},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Confidence 1"}, "properties": [{"id": "displayName", "value": "Avg Confidence"}]},
          {"matcher": {"id": "byName", "options": "Confidence 2"}, "properties": [{"id": "displayName", "value": "Min Confidence"}]},
          {"matcher": {"id": "byName", "options": "Confidence 3"}, "properties": [{"id": "displayName", "value": "Max Confidence"}]}
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {"id": "joinByLabels", "options": {"value": "label"}},
        {"id": "transpose", "options": {"firstFieldName": "Class", "restFieldsName": "Confidence"}}
      ]
    }
  ]
}
