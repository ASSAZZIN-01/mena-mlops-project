{
  "title": "MENA Model Monitoring",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "title": "Prediction requests by deployment",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum by (deployment) (rate(bentoml_service_request_total{endpoint=\"/predict\",http_response_code=\"200\"}[5m]))",
          "legendFormat": "{{deployment}}"
        }
      ]
    },
    {
      "title": "Request latency p95",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, deployment) (rate(bentoml_service_request_duration_seconds_bucket{endpoint=\"/predict\",http_response_code=\"200\"}[5m])))",
          "legendFormat": "{{deployment}}"
        }
      ]
    },
    {
      "title": "HTTP 5xx error rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "sum by (deployment) (rate(bentoml_service_request_total{endpoint=\"/predict\",http_response_code=~\"5..\"}[5m])) / sum by (deployment) (rate(bentoml_service_request_total{endpoint=\"/predict\"}[5m]))",
          "legendFormat": "{{deployment}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "title": "Service availability",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "min by (deployment) (up{job=~\"model-stable|model-candidate\"})",
          "legendFormat": "{{deployment}}"
        }
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 1}}
    },
    {
      "title": "Maximum feature PSI",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "mena_drift_psi_max",
          "legendFormat": "max PSI"
        }
      ],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.25}]}}}
    }
  ]
}
