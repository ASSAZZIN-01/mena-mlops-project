upstream sentiment_models {
    server model-stable:8000 weight=${STABLE_WEIGHT} max_fails=3 fail_timeout=10s;
    server model-candidate:8000 weight=${CANDIDATE_WEIGHT} max_fails=3 fail_timeout=10s;
}

server {
    listen 8080;

    add_header Access-Control-Allow-Origin $http_origin always;
    add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type, X-Request-ID, X-Source" always;

    if ($request_method = OPTIONS) {
        return 204;
    }

    location = /health {
        default_type application/json;
        return 200 '{"status":"healthy"}';
    }

    location / {
        proxy_pass http://sentiment_models;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
