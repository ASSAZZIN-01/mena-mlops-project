upstream sentiment_models {
    server model-stable:8000 weight=${STABLE_WEIGHT} max_fails=3 fail_timeout=10s;
    server model-candidate:8000 weight=${CANDIDATE_WEIGHT} max_fails=3 fail_timeout=10s;
}

server {
    listen 8080;

    location = /health {
        proxy_pass http://sentiment_models/healthz;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://sentiment_models;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
