# Add local, non-secret configuration here when needed.
HF_API_TOKEN=
KAGGLE_API_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/gcp-service-account.json

# Production defaults to the selected ONNX INT8 deployment representation.
STABLE_MODEL_BACKEND=onnx
STABLE_MODEL_PATH=./models/arabert-debug-variants
STABLE_MODEL_VERSION=onnx-int8-v1

# Candidate remains independently routable for future model versions.
CANDIDATE_MODEL_BACKEND=onnx
CANDIDATE_MODEL_PATH=./models/arabert-debug-variants
CANDIDATE_MODEL_VERSION=onnx-int8-candidate
MODEL_TOKENIZER_PATH=./models/arabert-debug-variants

# Reviewer dashboard links
GRAFANA_URL=http://localhost:3000
PROMETHEUS_URL=http://localhost:9090
FEEDBACK_URL=http://localhost:8502
# MLflow is included in the default Compose stack; override for an external server.
MLFLOW_URL=http://localhost:5000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_LOCATION=gs://mena-mlops-project-dvc/mlflow
AIRFLOW_URL=http://localhost:8081
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
# Temporary verification schedule; restore to a daily schedule after testing.
MENA_DRIFT_SCHEDULE=*/10 * * * *
MLFLOW_ALLOWED_HOSTS=localhost,localhost:5000,127.0.0.1,127.0.0.1:5000,mlflow,mlflow:5000
# Vertex AI Custom Job defaults; the image must be published to Artifact Registry.
VERTEX_PROJECT_ID=
VERTEX_REGION=us-central1
VERTEX_MACHINE_TYPE=n1-standard-4
VERTEX_ACCELERATOR_TYPE=NVIDIA_TESLA_T4
VERTEX_TRAINING_IMAGE_URI=
VERTEX_STAGING_BUCKET=gs://mena-mlops-project-dvc/vertex-staging
# Vertex jobs need a cloud-reachable MLflow URI, not localhost.
MLFLOW_TRACKING_URI=
