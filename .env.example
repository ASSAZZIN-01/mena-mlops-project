# Copy this file to .env. Never commit .env.
HF_API_TOKEN=
KAGGLE_API_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/gcp-service-account.json

# Production defaults to the selected ONNX INT8 deployment representation.
STABLE_MODEL_BACKEND=onnx
STABLE_MODEL_PATH=./models/arabert-debug-variants
STABLE_MODEL_VERSION=onnx-int8-v1

# Candidate remains independently routable for future model versions.
CANDIDATE_MODEL_BACKEND=onnx
CANDIDATE_MODEL_PATH=./models/arabert-debug-variants
CANDIDATE_MODEL_VERSION=onnx-int8-candidate
MODEL_TOKENIZER_PATH=./models/arabert-debug-variants

# Reviewer dashboard links
GRAFANA_URL=http://localhost:3000
PROMETHEUS_URL=http://localhost:9090
# The Control Center and feedback reviewer are served on port 8503.
FEEDBACK_URL=http://localhost:8503/reviewer
# Local Compose dashboard URL. Vertex jobs use MLFLOW_TRACKING_URI below.
MLFLOW_URL=http://localhost:5000
MLFLOW_ARTIFACT_LOCATION=gs://mena-mlops-project-dvc/mlflow
AIRFLOW_URL=http://localhost:8081
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
# Temporary verification schedule; restore to a daily schedule after testing.
MENA_DRIFT_SCHEDULE=*/10 * * * *
# Host path and group ID used by Airflow for the guarded local Compose deployment.
# Set these to the checkout path and Docker socket group on the grading machine.
MENA_HOST_PROJECT_ROOT=/absolute/path/to/mena-mlops-project
DOCKER_GID=
DOCKER_COMPOSE_COMMAND=docker-compose
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
STABLE_WEIGHT=95
CANDIDATE_WEIGHT=5
CANDIDATE_MODEL_FILE=model-int8.onnx
FEEDBACK_MIN_CONFIDENCE=0.25
FEEDBACK_MAX_CONFIDENCE=0.75
MLFLOW_PUBLIC_URL=http://localhost:5000
MLFLOW_ALLOWED_HOSTS=localhost,localhost:5000,127.0.0.1,127.0.0.1:5000,mlflow,mlflow:5000

# Vertex AI Custom Job configuration.
# VERTEX_PROJECT_ID is the Google Cloud project containing the job.
VERTEX_PROJECT_ID=
VERTEX_REGION=us-central1
VERTEX_MACHINE_TYPE=n1-standard-4
VERTEX_ACCELERATOR_TYPE=NVIDIA_TESLA_T4
VERTEX_TRAINING_IMAGE_URI=us-central1-docker.pkg.dev/mena-mlops-project/mena-mlops/training:latest
VERTEX_STAGING_BUCKET=gs://mena-mlops-project-dvc/vertex-staging
# This must be reachable from Google Cloud; localhost will not work in Vertex.
MLFLOW_TRACKING_URI=http://<MLFLOW_VM_EXTERNAL_IP>:5000
