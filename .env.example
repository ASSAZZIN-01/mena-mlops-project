# Add local, non-secret configuration here when needed.
HF_API_TOKEN=
KAGGLE_API_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/gcp-service-account.json

# Production defaults to the selected ONNX INT8 deployment representation.
STABLE_MODEL_BACKEND=onnx
STABLE_MODEL_PATH=./models/arabert-debug-variants
STABLE_MODEL_VERSION=onnx-int8-v1

# Candidate remains independently routable for future model versions.
CANDIDATE_MODEL_BACKEND=onnx
CANDIDATE_MODEL_PATH=./models/arabert-debug-variants
CANDIDATE_MODEL_VERSION=onnx-int8-candidate
MODEL_TOKENIZER_PATH=./models/arabert-debug
